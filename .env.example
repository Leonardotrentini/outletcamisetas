# Upstash Redis (https://console.upstash.com)
# Também aceita KV_REST_API_URL / KV_REST_API_TOKEN (Vercel KV)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Meta Pixel + Conversions API (CAPI) — NUNCA exponha o token no front
META_PIXEL_ID=997299299778029
META_CAPI_ACCESS_TOKEN=

# Opcional: código de teste do Events Manager
# META_TEST_EVENT_CODE=TEST12345

# Opcional: sobrescreve sellers.json (um por linha ou vírgula). Formato: 5511... ou Nome|5511...
# OUTLET_SELLERS=5511915887485,5511949808009

